{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/*.py": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/analyze-topic",
      "destination": "/api/analyze_topic"
    },
    {
      "source": "/api/context-step",
      "destination": "/api/context_step"
    },
    {
      "source": "/api/create-motion",
      "destination": "/api/create_motion"
    },
    {
      "source": "/api/debate-step",
      "destination": "/api/debate_step"
    },
    {
      "source": "/api/neutral-summary",
      "destination": "/api/neutral_summary"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/public/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/public/app.js"
    },
    {
      "source": "/debate_stream.js",
      "destination": "/public/debate_stream.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    }
  ]
}
